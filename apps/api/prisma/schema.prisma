// Udyoga Sakha — Prisma Schema (MySQL 8.0)
// npx prisma migrate dev --name init

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ── Enums ─────────────────────────────────────────────────────────────────────

enum RoleType {
  INTERN
  FRESHER
  JOB_SEEKER
  FREELANCER
  CONSULTANT
  HIRING_MANAGER
  RECRUITER
  TRAINER
  VENDOR
  MODERATOR_ROLE
  RFP_PROVIDER
}

enum MarketField {
  IT_FIELD
  NON_IT_FIELD
  SERVICES
}

enum MarketSegment {
  IT_DEVELOPERS
  IT_DESIGNERS
  IT_PRODUCT_OWNERS
  IT_DATA_AI
  NON_IT_ARTS_MEDIA
  NON_IT_COMMERCE
  NON_IT_EDUCATION
  NON_IT_SPIRITUAL
  NON_IT_MANAGEMENT
  NON_IT_HEALTHCARE
  NON_IT_ENGINEERING
  SERVICES_CONSULTANCY
  SERVICES_TRAINING
  SERVICES_RECRUITMENT
  SERVICES_VENDOR
}

enum WorkMode {
  WFH
  ON_SITE
  HYBRID
  OFF_SITE
}

enum ListingType {
  JOB_OPENING
  INTERNSHIP
  RFP_TENDER
  TRAINING_PROGRAM
  CONSULTANCY_NEED
  VENDOR_REQUIREMENT
}

enum PaymentType {
  PAID
  UNPAID
  STIPEND
  NEGOTIABLE
}

enum CertOpt {
  YES
  NO
}

enum EmpOption {
  EXISTS
  NOT_EXISTS
}

enum ProfileStatus {
  PENDING
  APPROVED
  REJECTED
}

enum UserRole {
  PARTICIPANT
  MODERATOR
  ADMIN
}

enum DocumentType {
  RESUME
  CERTIFICATE
  PORTFOLIO
  COVER_LETTER
  PHOTO
}

enum Industry {
  IT_SOFTWARE
  HEALTHCARE
  FINANCE_BANKING
  GOVERNMENT_PSU
  EDUCATION
  ENGINEERING
  MARKETING
  SERVICES
  OTHER
}

enum ExperienceLevel {
  ANY
  FRESHER_0_1
  EXP_1_3
  EXP_3_5
  EXP_5_8
  EXP_8_PLUS
}

enum Duration {
  SHORT_TERM
  MEDIUM_TERM
  LONG_TERM
  PERMANENT
  PROJECT_BASED
}

// ── Models ────────────────────────────────────────────────────────────────────

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  phone        String   @unique
  name         String
  passwordHash String   @map("password_hash")
  // MySQL has no native array type — roles stored as JSON array e.g. ["PARTICIPANT"]
  // Read with: (user.roles as UserRole[])
  roles        Json     @default("[]")
  city         String?

  profiles              CandidateProfile[]    @relation("UserProfiles")
  listings              JobListing[]          @relation("ListingOwner")
  reviewedProfiles      CandidateProfile[]    @relation("ProfileReviewer")
  reviewedListings      JobListing[]          @relation("ListingReviewer")
  refreshTokens         RefreshToken[]
  notifications         Notification[]
  userProfile           UserProfile?
  userDocuments         UserDocument[]
  verifiedDocuments     UserDocument[]        @relation("DocumentVerifier")
  trustRecord           TrustRecord?
  verificationRequests  VerificationRequest[]
  reviewedVerifications VerificationRequest[] @relation("VerificationReviewer")
  reports               Report[]              @relation("ReportReporter")
  resolvedReports       Report[]              @relation("ReportResolver")
  passwordResetTokens   PasswordResetToken[]
  payments              Payment[]
  wallet                Wallet?
  listingUnlocks        ListingUnlock[]
  profileUnlocks        ProfileUnlock[]       @relation("ProfileUnlockByUser")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt      @map("updated_at")

  @@map("users")
}

model RefreshToken {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  token     String   @unique @db.VarChar(512)
  expiresAt DateTime @map("expires_at")
  used      Boolean  @default(false)
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_tokens")
}

model PasswordResetToken {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  tokenHash String   @unique @map("token_hash") @db.VarChar(512)
  expiresAt DateTime @map("expires_at")
  used      Boolean  @default(false)
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("password_reset_tokens")
}

model JobListing {
  id                  String          @id @default(uuid())
  organisationName    String          @map("organisation_name")
  contactPerson       String?         @map("contact_person")
  contactEmail        String?         @map("contact_email")
  contactPhone        String?         @map("contact_phone")
  listingType         ListingType     @map("listing_type")
  targetRoleType      RoleType        @map("target_role_type")
  title               String
  industry            Industry        @default(OTHER)
  location            String          @default("")
  payment             PaymentType     @default(PAID)
  salary              String?
  workMode            WorkMode        @default(ON_SITE)    @map("work_mode")
  certificateProvided CertOpt         @default(NO)         @map("certificate_provided")
  employmentOption    EmpOption       @default(NOT_EXISTS) @map("employment_option")
  experienceRequired  ExperienceLevel @default(ANY)        @map("experience_required")
  duration            Duration        @default(PERMANENT)
  // String[] fields stored as JSON arrays — cast to string[] in application code
  skills              Json            @default("[]")
  facilities          Json            @default("[]")
  responsibilities    Json            @default("[]")
  requirements        Json            @default("[]")
  description         String          @db.Text
  experienceDetail    String?         @map("experience_detail") @db.Text
  marketField         MarketField     @map("market_field")
  status              ProfileStatus   @default(PENDING)
  icon                String?
  postedById          String?         @map("posted_by_id")
  reviewedById        String?         @map("reviewed_by_id")
  reviewedAt          DateTime?       @map("reviewed_at")
  rejectionReason     String?         @map("rejection_reason") @db.Text
  postedAt            DateTime        @default(now()) @map("posted_at")
  featured            Boolean         @default(false)
  featuredUntil       DateTime?       @map("featured_until")

  postedBy   User? @relation("ListingOwner",   fields: [postedById],   references: [id])
  reviewedBy User? @relation("ListingReviewer", fields: [reviewedById], references: [id])
  unlocks    ListingUnlock[]

  @@index([status])
  @@index([targetRoleType])
  @@index([marketField])
  @@map("job_listings")
}

model CandidateProfile {
  id       String   @id @default(uuid())
  userId   String   @map("user_id")
  roleType RoleType @map("role_type")

  // Personal
  fullName    String  @map("full_name")
  dateOfBirth String? @map("date_of_birth")
  gender      String?
  phone       String?
  email       String?
  city        String?
  // String[] stored as JSON array — cast to string[] in application code
  skills      Json    @default("[]")
  summary     String? @db.Text

  // Education
  highestDegree  String? @map("highest_degree")
  specialization String?
  institution    String?
  yearOfPassing  Int?    @map("year_of_passing")
  grade          String?

  // Role-specific extra fields (stored as JSON key→value pairs)
  roleFields Json @default("{}") @map("role_fields")

  // Submission details
  appliedFor        String        @map("applied_for")
  appliedAt         String        @map("applied_at_org")
  payment           PaymentType   @default(PAID)
  certificate       CertOpt       @default(NO)
  workMode          WorkMode      @default(ON_SITE)    @map("work_mode")
  employmentOption  EmpOption     @default(NOT_EXISTS) @map("employment_option")
  marketSegment     MarketSegment @map("market_segment")
  preferredLocation String?       @map("preferred_location")

  // Moderator review
  status          ProfileStatus @default(PENDING)
  rejectionReason String?       @map("rejection_reason") @db.Text
  marketField     MarketField?  @map("market_field")
  submittedAt     DateTime      @default(now()) @map("submitted_at")
  reviewedAt      DateTime?     @map("reviewed_at")
  reviewedById    String?       @map("reviewed_by_id")

  user        User                @relation("UserProfiles",          fields: [userId],       references: [id], onDelete: Cascade)
  reviewer    User?               @relation("ProfileReviewer",       fields: [reviewedById], references: [id])
  experiences ExperienceEntry[]
  documents   CandidateDocument[]
  unlocks     ProfileUnlock[]     @relation("ProfileUnlockOnProfile")

  @@unique([userId, roleType])
  @@index([status])
  @@index([roleType])
  @@map("candidate_profiles")
}

model ExperienceEntry {
  id           String  @id @default(uuid())
  profileId    String  @map("profile_id")
  title        String
  company      String
  fromDate     String? @map("from_date")
  toDate       String? @map("to_date")
  description  String? @db.Text
  displayOrder Int     @default(0) @map("display_order")

  profile CandidateProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([profileId])
  @@map("experience_entries")
}

model CandidateDocument {
  id           String       @id @default(uuid())
  profileId    String       @map("profile_id")
  documentType DocumentType @map("document_type")
  filename     String
  mimeType     String       @map("mime_type")
  sizeBytes    Int          @map("size_bytes")
  storageKey   String       @map("storage_key")
  approvedAt   DateTime?    @map("approved_at")
  uploadedAt   DateTime     @default(now()) @map("uploaded_at")

  profile CandidateProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([profileId])
  @@map("candidate_documents")
}

// ── Audit Log ─────────────────────────────────────────────────────────────────

model AuditLog {
  id         String   @id @default(uuid())
  entityType String   @map("entity_type")
  entityId   String   @map("entity_id")
  action     String
  actorId    String?  @map("actor_id")
  actorEmail String?  @map("actor_email")
  oldState   Json?    @map("old_state")
  newState   Json?    @map("new_state")
  metadata   Json?
  ts         DateTime @default(now())

  @@index([entityType, entityId])
  @@index([actorId])
  @@index([ts])
  @@map("audit_log")
}

// ── Notifications ─────────────────────────────────────────────────────────────

model Notification {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  subject   String
  body      String   @db.Text
  read      Boolean  @default(false)
  link      String?
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, read])
  @@index([createdAt])
  @@map("notifications")
}

model UserProfile {
  userId          String  @id @map("user_id")
  fullName        String  @map("full_name")
  bio             String? @db.Text
  location        String?
  participantType String? @map("participant_type")
  orgName         String? @map("org_name")
  showContact     Boolean @default(true) @map("show_contact")
  avatarKey       String? @map("avatar_key")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_profiles")
}

enum UserDocumentType {
  NATIONAL_ID
  PASSPORT
  DEGREE_CERTIFICATE
  PROFESSIONAL_CERTIFICATE
  TAX_ID
  OTHER
}

model UserDocument {
  id           String           @id @default(uuid())
  userId       String           @map("user_id")
  documentType UserDocumentType @map("document_type")
  filename     String
  mimeType     String           @map("mime_type")
  sizeBytes    Int              @map("size_bytes")
  storageKey   String           @map("storage_key")
  verifiedAt   DateTime?        @map("verified_at")
  verifierId   String?          @map("verifier_id")
  uploadedAt   DateTime         @default(now()) @map("uploaded_at")

  user     User  @relation(fields: [userId],    references: [id], onDelete: Cascade)
  verifier User? @relation("DocumentVerifier",  fields: [verifierId], references: [id])

  @@index([userId])
  @@map("user_documents")
}

model TrustRecord {
  userId               String   @id @map("user_id")
  currentLevel         String   @default("L0") @map("current_level")
  reputationScore      Int      @default(0)    @map("reputation_score")
  completedEngagements Int      @default(0)    @map("completed_engagements")
  lastUpdated          DateTime @default(now()) @map("last_updated")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("trust_records")
}

enum VerificationStatus {
  PENDING
  APPROVED
  REJECTED
}

model VerificationRequest {
  id          String             @id @default(uuid())
  userId      String             @map("user_id")
  // String[] stored as JSON array — cast to string[] in application code
  documentIds Json               @default("[]") @map("document_ids")
  status      VerificationStatus @default(PENDING)
  reviewNote  String?            @map("review_note") @db.Text
  reviewedAt  DateTime?          @map("reviewed_at")
  reviewerId  String?            @map("reviewer_id")
  createdAt   DateTime           @default(now()) @map("created_at")

  user     User  @relation(fields: [userId],    references: [id], onDelete: Cascade)
  reviewer User? @relation("VerificationReviewer", fields: [reviewerId], references: [id])

  @@index([userId])
  @@index([status])
  @@map("verification_requests")
}

enum ReportStatus {
  PENDING
  REVIEWED
  RESOLVED
  DISMISSED
}

enum ReportSubjectType {
  USER
  LISTING
  PROFILE
}

model Report {
  id          String            @id @default(uuid())
  reporterId  String            @map("reporter_id")
  subjectType ReportSubjectType @map("subject_type")
  subjectId   String            @map("subject_id")
  reason      String            @db.Text
  detail      String?           @db.Text
  status      ReportStatus      @default(PENDING)
  resolution  String?           @db.Text
  resolvedBy  String?           @map("resolved_by")
  resolvedAt  DateTime?         @map("resolved_at")
  createdAt   DateTime          @default(now()) @map("created_at")

  reporter User  @relation("ReportReporter", fields: [reporterId], references: [id])
  resolver User? @relation("ReportResolver", fields: [resolvedBy],  references: [id])

  @@index([status])
  @@index([subjectType, subjectId])
  @@map("reports")
}

enum PaymentPurpose {
  LISTING_FEATURE
  CERTIFICATION_FEE
  REGISTRATION_FEE
  WALLET_TOPUP
  OTHER
}

enum PaymentStatus {
  CREATED
  AUTHORIZED
  CAPTURED
  FAILED
  REFUNDED
}

enum PaymentMethod {
  CARD
  UPI
  NETBANKING
  WALLET
  EMI
  PAYLATER
  INTERNATIONAL_CARD
  OTHER
}

model Payment {
  id                   String         @id @default(uuid())
  userId               String         @map("user_id")
  purpose              PaymentPurpose
  referenceId          String?        @map("reference_id")
  amountPaise          Int            @map("amount_paise")
  currency             String         @default("INR")
  razorpayOrderId      String         @unique @map("razorpay_order_id")
  razorpayPaymentId    String?        @map("razorpay_payment_id")
  status               PaymentStatus  @default(CREATED)
  method               PaymentMethod?
  internationalPayment Boolean        @default(false) @map("international_payment")
  failureReason        String?        @map("failure_reason")
  refundedPaise        Int?           @map("refunded_paise")
  metadata             Json?
  createdAt            DateTime       @default(now()) @map("created_at")
  updatedAt            DateTime       @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([status])
  @@index([purpose, referenceId])
  @@map("payments")
}

model Wallet {
  id        String   @id @default(uuid())
  userId    String   @unique @map("user_id")
  balance   Int      @default(0)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt      @map("updated_at")

  user         User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions PointTransaction[]

  @@map("wallets")
}

enum TransactionType {
  SIGNUP_BONUS
  JOB_UNLOCK
  PROFILE_UNLOCK
  TOPUP
  ADMIN_ADJUSTMENT
}

model PointTransaction {
  id          String          @id @default(uuid())
  walletId    String          @map("wallet_id")
  amount      Int
  type        TransactionType
  referenceId String?         @map("reference_id")
  note        String?         @db.Text
  createdAt   DateTime        @default(now()) @map("created_at")

  wallet Wallet @relation(fields: [walletId], references: [id], onDelete: Cascade)

  @@index([walletId])
  @@map("point_transactions")
}

model ListingUnlock {
  id         String   @id @default(uuid())
  userId     String   @map("user_id")
  listingId  String   @map("listing_id")
  unlockedAt DateTime @default(now()) @map("unlocked_at")

  user    User       @relation(fields: [userId],    references: [id], onDelete: Cascade)
  listing JobListing @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@unique([userId, listingId])
  @@index([userId])
  @@map("listing_unlocks")
}

model ProfileUnlock {
  id         String   @id @default(uuid())
  userId     String   @map("user_id")
  profileId  String   @map("profile_id")
  unlockedAt DateTime @default(now()) @map("unlocked_at")

  user    User             @relation("ProfileUnlockByUser",    fields: [userId],    references: [id], onDelete: Cascade)
  profile CandidateProfile @relation("ProfileUnlockOnProfile", fields: [profileId], references: [id], onDelete: Cascade)

  @@unique([userId, profileId])
  @@index([userId])
  @@map("profile_unlocks")
}

// ── Admin Portal Users ────────────────────────────────────────────────────────
// Separate from the main User table. Admin portal staff never need to
// register on the public platform. Managed via the admin portal's
// "Manage Admins" page (ADMIN role only).

enum AdminRole {
  ADMIN
  MODERATOR
}

model AdminUser {
  id           String    @id @default(uuid())
  email        String    @unique
  name         String
  passwordHash String    @map("password_hash")
  role         AdminRole @default(MODERATOR)
  isActive     Boolean   @default(true) @map("is_active")
  createdById  String?   @map("created_by_id")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt      @map("updated_at")

  @@map("admin_users")
}
